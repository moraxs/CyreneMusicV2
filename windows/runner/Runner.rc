/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            // 注意：path_provider_windows 在运行时从这里读 CompanyName 与
            // ProductName，拼出 %APPDATA%\<CompanyName>\<ProductName> 当作应用
            // 数据目录（偏好、崩溃日志、歌曲缓存都落在里面）。改这两行等于给
            // 应用数据搬家，务必同步 WindowsAppDataMigration 里的旧路径常量。
            //
            // 也别改成 "Cyrene Music"\"Cyrene Music"——那是原版 cyrene_music
            // 项目占用的目录，两个应用会共用同一份 shared_preferences.json。
            VALUE "CompanyName", "Cyrene" "\0"
            VALUE "FileDescription", "Cyrene Music" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", "Cyrene Music" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Cyrene. All rights reserved." "\0"
            // 必须与 windows/CMakeLists.txt 的 BINARY_NAME 保持一致。
            VALUE "OriginalFilename", "cyrene_music_reborn.exe" "\0"
            VALUE "ProductName", "Cyrene Music" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

#endif    // English (United States) resources
